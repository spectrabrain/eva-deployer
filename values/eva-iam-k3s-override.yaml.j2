# Rendered helm override for eva-iam on k3s (base: chart values.yaml).
# Driven by eva_iam_* ansible variables — see roles/eva_iam/tasks/main.yaml for defaults.
# Site-specific values belong in values/eva-iam.yaml, which is applied after this file.
#
# Keys here must match the chart's schema. Check after a chart bump:
#   helm show values eva-iam/eva-iam --version <version>
config:
  host: "{{ eva_iam_host }}"

keycloak:
{% if airgap_mode | bool %}
  # airgap: 모든 이미지를 Harbor 에서 받습니다. cloud 모드에서는 이 블록을 렌더하지 않고
  # 차트 기본값(ECR 주소)을 그대로 씁니다 — 여기 주소를 박아두면 차트 bump 때 낡습니다.
  image:
    repository: "{{ eva_iam_keycloak_image_repository }}"
    pullPolicy: IfNotPresent
  # keycloak Deployment 와 realm-config Job 의 initContainer (차트 3.1.3+ 에서 노출됨).
  # 그 전 버전은 busybox 를 템플릿에 하드코딩해서 docker.io mirror 로 우회해야 했습니다.
  initContainer:
    image:
      repository: "{{ eva_iam_busybox_image_repository }}"
{% endif %}
  # config-cli 로 표현 못 하는 realm 부분 (post-install/upgrade Job, kcadm)
  realmPatch:
    realmAdmin:
      password: {{ eva_iam_admin_password | to_json }}
    evaApp:
      redirectUris:
{% for uri in eva_iam_app_redirect_uris %}
        - {{ uri | to_json }}
{% endfor %}
  realmConfig:
{% if airgap_mode | bool %}
    image:
      repository: "{{ eva_iam_config_cli_image_repository }}"
{% endif %}
    substitutions:
      EVA_IAM_ADMIN_EMAIL: "{{ eva_iam_admin_email }}"

{% if airgap_mode | bool %}
dispatcher:
  image:
    repository: "{{ eva_iam_dispatcher_image_repository }}"
    pullPolicy: IfNotPresent

{% endif %}
ingress:
  path: "{{ eva_iam_ingress_path }}"
  tls:
    authType: hostPath
    hostPath: "{{ eva_iam_tls_host_path }}"
{% if airgap_mode | bool %}
    # TLS Secret 을 만드는 Job 의 kubectl 이미지 (차트 3.1.3+ 에서 노출됨)
    job:
      kubectlImage:
        repository: "{{ eva_iam_kubectl_image_repository }}"
{% endif %}

persistence:
  type: hostPath
  hostPath:
    path: "{{ eva_iam_persistence_host_path }}"

pv:
  create: false

database:
  type: internal
  internal:
{% if airgap_mode | bool %}
    image:
      repository: "{{ eva_iam_postgres_image_repository }}"
{% endif %}
    service:
      nodePort: {{ eva_iam_db_nodeport }}
    password: {{ eva_iam_db_password | to_json }}

redis:
{% if airgap_mode | bool %}
  image:
    repository: "{{ eva_iam_redis_image_repository }}"
{% endif %}
  auth:
    password: {{ eva_iam_redis_password | to_json }}
  tls:
    enabled: {{ eva_iam_redis_tls_enabled | bool | lower }}
  external:
    enabled: {{ eva_iam_redis_external_enabled | bool | lower }}
    nodePort: {{ eva_iam_redis_nodeport }}

imagePullSecrets:
  enabled: {{ (repository_mode == 'cloud_repository') | lower }}
  create: {{ (repository_mode == 'cloud_repository') | lower }}
  authType: "{{ eva_iam_image_pull_auth_type }}"
  hostPath: "{{ eva_iam_image_pull_host_path }}"
  secretName: "{{ eva_iam_image_pull_secret_name }}"

serviceAccount:
  create: true
