# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
env/

# IDEs
.vscode/
.idea/

config/
deploy/

logs/
logs_*/
logs_infra/
logs_eva/
install/
!install/
install/*
!install/*.sh
!install/*.txt
install/manifest.txt

*.ini

# Always include config role files
!roles/config/
!roles/config/**

# Deployment-specific EVA App host values (contains license credentials)
values/app.yaml

# EVA IAM host settings (contains secrets / client credentials)
values/eva-iam.yaml

# Keycloak realm exports contain client secrets + signing keys — never commit
eva-iam-realm-*.json
*-realm-export*.json
