server.example.com:
  eva_iam_deploy:
    namespace: eva-iam
  config:
    host: iam.example.com
  keycloak:
    realmPatch:
      realmAdmin:
        password: "<REALM_ADMIN_PASSWORD>"
      evaApp:
        redirectUris:
          - "https://app.example.com/*"
    realmConfig:
      substitutions:
        EVA_IAM_ADMIN_EMAIL: "admin@example.com"
  ingress:
    path: /
    tls:
      hostPath: "<TLS_CERT_DIRECTORY>"
  persistence:
    hostPath:
      path: "<IAM_DATA_DIRECTORY>"
  database:
    internal:
      service:
        nodePort: 32091
      password: "<POSTGRES_PASSWORD>"
  redis:
    auth:
      password: "<REDIS_PASSWORD>"
    tls:
      enabled: true
    external:
      enabled: true
      nodePort: 32079
  imagePullSecrets:
    hostPath: "<AWS_CREDENTIALS_DIRECTORY>"
