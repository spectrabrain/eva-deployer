# Rendered helm override for eva-iam (base: chart values.yaml).
# Mirrors prod_values.yaml; driven by eva_iam_* ansible variables.
config:
  host: {{ eva_iam_host }}

keycloak:
  realmConfig:
    substitutions:
      EVA_IAM_ADMIN_PASSWORD: "{{ eva_iam_admin_password }}"
      EVA_IAM_ADMIN_EMAIL: "{{ eva_iam_admin_email }}"
      EVA_APP_REDIRECT_URI: "{{ eva_iam_app_redirect_uri if (eva_iam_app_redirect_uri | length > 0) else ('https://' ~ eva_iam_host ~ '/*') }}"

ingress:
  path: {{ eva_iam_ingress_path }}
  tls:
    hostPath: {{ eva_iam_tls_host_path }}

persistence:
  hostPath:
    path: {{ eva_iam_persistence_host_path }}

database:
  internal:
    service:
      nodePort: {{ eva_iam_db_nodeport }}

imagePullSecrets:
  hostPath: {{ eva_iam_image_pull_host_path }}
