# eva-iam 배포 설정 (호스트별). 긴 -e 대신 여기서 관리합니다.
#   cp values/eva-iam.yaml.sample values/eva-iam.yaml   # 복사 후 편집 (git 커밋 금지)
#   ansible-playbook -i inventory.ini site_eva_iam.yaml -e eva_iam_become=false
#
# 최상위 키 = 배포 대상 host (ansible_host / inventory hostname). 단일 호스트면 그 이름 한 블록.
# realm/client secret 등은 helm chart 안에서 처리됩니다. 여기선 chart override 값만 지정.
#
# 파일시스템 경로는 기본적으로 eva_iam_base_dir(기본 ~/.eva-iam) 밑으로 잡힙니다:
#   certs        -> {base}/certs
#   persistence  -> {base}/host-path
#   workdir      -> {base}

e2e.eva-dev.lge.com:
  # --- 대상/버전 ---
  eva_iam_namespace: eva-iam
  eva_iam_host: e2e.eva-dev.lge.com
  # eva_iam_base_dir: /home/eva/.eva-iam    # 기본값. 바꾸면 certs/host-path/workdir 전부 따라감
  # eva_iam_chart_version: 0.1.6            # 미지정 시 versions.json 값 사용

  # --- realm 관리자 (chart realmConfig.substitutions 로 주입) ---
  eva_iam_admin_password: "ChangeMe-1!"
  eva_iam_admin_email: "admin@eva.com"
  # eva_iam_app_redirect_uri: "https://e2e.eva-dev.lge.com/*"   # 생략 시 host에서 자동 유도

  # --- ingress ---
  eva_iam_ingress_path: /iam

  # --- DB NodePort ---
  eva_iam_db_nodeport: 32091

  # --- ECR 자격증명(노드) ---
  eva_iam_image_pull_host_path: /home/eva/.aws

  # --- 경로 개별 override가 필요할 때만 (기본은 base_dir 밑) ---
  # eva_iam_tls_host_path: /home/eva/.eva-iam/certs
  # eva_iam_persistence_host_path: /home/eva/.eva-iam/host-path
