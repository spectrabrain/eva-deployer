# EVA Agent target-specific values. Copy to <workspace>/site-values/agent.yaml.
# The top-level key must be the inventory hostname (or ansible_host when set).
# Do not commit a real file when it contains site credentials.
#
# GPU count, MIG resource selection, vLLM replica count, and model cache defaults
# are derived from Config's eva.yaml. Specify only intentional site overrides.
#
# site-dev-196:
#   eva_agent_deploy:
#     # One of: A6000x1, L40sx1, PRO5000x3, PRO6000-MIGx4.
#     vllm_profile: PRO6000-MIGx4
#     # Set only when the site requires a specific persistent NFS/cache location.
#     # nfs_share_path: /data001/share/eva-agent
#     # Qdrant persistent snapshot volume size; default is 10Gi.
#     # qdrant_snapshot_pv_size: 50Gi
#
#   # EVA Agent chart values. The Cloud default image repository, image pull
#   # configuration, and cache path are generated by the role; override only a
#   # chart field deliberately supported by the installed chart.
#   image:
#     pullPolicy: Always
