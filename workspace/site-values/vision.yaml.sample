# EVA Vision target-specific values. Copy to <workspace>/site-values/vision.yaml.
# The top-level key must be the inventory hostname (or ansible_host when set).
# Do not commit a real file when it contains site credentials.
#
# GPU count and the nvidia.com/gpu or MIG resource name are selected from Config's
# eva.yaml and Kubernetes allocatable resources. Do not repeat those values here.
#
# site-dev-196:
#   eva_vision_deploy:
#     # Deployment behavior only. GPU/MIG values remain automatically derived.
#     rollout_timeout: 2400s
#
#   # EVA Vision chart values for intentional site overrides.
#   image:
#     pullPolicy: Always
#   persistence:
#     enabled: true
#     storageClass: local-path
#     size: 100Gi
#   resources:
#     requests:
#       cpu: "4"
#       memory: 24Gi
#     limits:
#       cpu: "4"
#       memory: 24Gi
