# Cloud 설치 기본 틀. <...>는 필수 입력이며 남아 있으면 검증에 실패합니다.
# 이 파일은 config sample이 접속 환경별 Values 템플릿과 결합합니다.
schema_version: v1

site:
  id: "<SITE_ID>" # 필수: 영문/숫자로 시작하는 설치 환경 식별자. ex) customer-a

repository:
  mode: cloud
  project: eva

components:
  infra: true
  iam: true
  agent: true
  vision: true
  app: true
  n8n: false

credentials:
  aws:
    aws_access_key_id: "<AWS_ACCESS_KEY_ID>" # 필수: Cloud AWS credential. ex) AKIAEXAMPLEONLY000000 (실제 발급값으로 교체)
    aws_secret_access_key: "<AWS_SECRET_ACCESS_KEY>" # 필수: 커밋 금지. ex) demo-aws-secret-only (실제 발급값으로 교체)
    region: ap-northeast-2

targets:
  server-a: # inventory alias. Values 안에 이 이름을 다시 넣지 않습니다.
    ansible:
      ansible_connection: local # 설치 대상 서버에서 실행하는 기본 틀
      ansible_user: "<TARGET_USER>" # 필수: 대상 서버 사용자. ex) eva
      ansible_become: true
      ansible_become_password: "<SUDO_PASSWORD>" # 필수: 대상 sudo 비밀번호, passwordless sudo이면 제거. ex) demo-sudo-only (예시 전용)
    values:
      iam:
        keycloak:
          realmConfig:
            substitutions:
              EVA_IAM_ADMIN_EMAIL: "admin@eva.com" # 기본 관리자 이메일. 사이트 정책에 맞게 변경합니다.
