---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: eva-vision-ecr-refresh
  namespace: {{ eva_vision_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: eva-vision-ecr-refresh
  namespace: {{ eva_vision_namespace }}
rules:
  - apiGroups: [""]
    resources: [secrets]
    resourceNames: [{{ eva_vision_runtime_values.imagePullSecrets.ExistingSecret | to_json }}]
    verbs: [get, patch, update]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: eva-vision-ecr-refresh
  namespace: {{ eva_vision_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: eva-vision-ecr-refresh
subjects:
  - kind: ServiceAccount
    name: eva-vision-ecr-refresh
    namespace: {{ eva_vision_namespace }}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: eva-vision-ecr-refresh
  namespace: {{ eva_vision_namespace }}
  annotations:
    meta.helm.sh/release-name: eva-vision
    meta.helm.sh/release-namespace: {{ eva_vision_namespace }}
spec:
  schedule: "0 */6 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      activeDeadlineSeconds: 300
      template:
        spec:
          serviceAccountName: eva-vision-ecr-refresh
          restartPolicy: Never
          securityContext:
            fsGroup: 1001
          volumes:
            - name: token
              emptyDir: {medium: Memory}
          initContainers:
            - name: token
              image: amazon/aws-cli:2.33.8
              command: [/bin/sh, -ec]
              args:
                - 'umask 027; aws ecr get-login-password --region "$AWS_REGION" > /shared/token'
              envFrom:
                - secretRef:
                    name: {{ eva_online_secret }}
              env:
                - name: AWS_REGION
                  value: {{ eva_vision_runtime_values.imagePullSecrets.region | default('ap-northeast-2') | to_json }}
              volumeMounts:
                - name: token
                  mountPath: /shared
          containers:
            - name: update
              image: bitnami/kubectl:latest
              command: [/bin/sh, -ec]
              args:
                - >-
                  auth=$(printf 'AWS:%s' "$(cat /shared/token)" | base64 | tr -d '\n');
                  config=$(printf '{"auths":{"%s":{"auth":"%s"}}}' "$REGISTRY" "$auth" | base64 | tr -d '\n');
                  printf '{"data":{".dockerconfigjson":"%s"}}' "$config" |
                  kubectl -n "$NAMESPACE" patch secret "$SECRET" --type=merge --patch-file=/dev/stdin >/dev/null
              env:
                - name: REGISTRY
                  value: {{ eva_vision_runtime_values.image.repository.split('/')[0] | to_json }}
                - name: NAMESPACE
                  value: {{ eva_vision_namespace | to_json }}
                - name: SECRET
                  value: {{ eva_vision_runtime_values.imagePullSecrets.ExistingSecret | to_json }}
              volumeMounts:
                - name: token
                  mountPath: /shared
                  readOnly: true
