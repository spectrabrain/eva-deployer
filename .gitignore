# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
env/

# IDEs
.vscode/
.idea/

# Local design notes and implementation planning are not release artifacts.
docs/todo/
docs/development/
docs/architecture/

out/cache/*
!out/cache/.gitkeep
out/work/*
!out/work/.gitkeep

# Local EVA CLI development binary. Release builds use out/work/build/eva.
/tools/eva/eva
out/state/*
!out/state/.gitkeep
out/dist/*
!out/dist/.gitkeep
# Local workspace inputs/outputs (inventory, credentials, site values, exports).
# Only the bundled samples and placeholders are tracked.
workspace/*
!workspace/credentials/
!workspace/inventory/
!workspace/site-values/
workspace/credentials/*
!workspace/credentials/*.sample
workspace/inventory/*
!workspace/inventory/.gitkeep
!workspace/inventory/*.sample
workspace/site-values/*
!workspace/site-values/.gitkeep
!workspace/site-values/*.sample

*.ini

# Default single-file installer inputs contain site credentials.
eva-install*.yaml

# Deployment-specific EVA App host values (contains license credentials)
values/app.yaml
workspace/site-values/app.yaml

# EVA IAM host settings (contains secrets / client credentials)
values/eva-iam.yaml
workspace/site-values/iam.yaml

# Keycloak realm exports contain client secrets + signing keys — never commit
eva-iam-realm-*.json
*-realm-export*.json
